{
  "$schema": "https://opencode.ai/config.json",

  // Switchblade: default is the committed src/free-fallbacks.json,
  // filtered to currently available zero-cost chat models.
  "plugins": ["opencode-plugin-switchblade"]

  // Use a custom ladder instead:
  // "plugins": [
  //   {
  //     "package": "opencode-plugin-switchblade",
  //     "options": {
  //       "fallbacks": [
  //         { "providerID": "opencode", "id": "pulse-alpha-free" },
  //         { "providerID": "opencode", "id": "deepseek-v4.1-flash-free" }
  //       ]
  //     }
  //   }
  // ]
}
