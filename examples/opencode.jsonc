{
  "$schema": "https://opencode.ai/config.json",

  // Switchblade: committed public baseline, validated at load time and again
  // before a runtime candidate is selected. Set timeoutSwitchAfterAttempt: 1
  // to switch immediately on timeouts instead of the default (2).
  "plugins": [
    {
      "package": "opencode-plugin-switchblade",
      "options": {
        "timeoutSwitchAfterAttempt": 2,
        "exhaustedResetMs": 3600000,
        "autoResume": true
      }
    }
  ]

  // Explicit fallback override (takes precedence over the baseline):
  // "plugins": [
  //   {
  //     "package": "opencode-plugin-switchblade",
  //     "options": {
  //       "fallbacks": [
  //         { "providerID": "opencode", "id": "pulse-alpha-free" },
  //         { "providerID": "opencode", "id": "deepseek-v4.1-flash-free" }
  //       ],
  //       "timeoutSwitchAfterAttempt": 2
  //     }
  //   }
  // ]
}
