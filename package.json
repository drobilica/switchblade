{
  "name": "opencode-plugin-switchblade",
  "version": "0.2.0",
  "type": "module",
  "description": "OpenCode server plugin: auto-switch to a free fallback model when a provider hits a rate/weekly/quota limit (429/402), then retry immediately.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/helpers.test.mjs tests/baseline.test.mjs",
    "update:models": "node scripts/update-free-fallbacks.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "opencode",
    "plugin",
    "fallback",
    "rate-limit"
  ],
  "author": "drobilica",
  "repository": {
    "type": "git",
    "url": "https://github.com/drobilica/switchblade.git"
  },
  "homepage": "https://github.com/drobilica/switchblade#readme",
  "bugs": {
    "url": "https://github.com/drobilica/switchblade/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
