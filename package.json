{
  "name": "opencode-plugin-switchblade",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode server plugin: auto-switch to a free fallback model when a provider hits a rate/weekly/quota limit (429/402), then retry immediately.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/helpers.test.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "opencode",
    "plugin",
    "fallback",
    "rate-limit"
  ],
  "author": "drobilica",
  "repository": {
    "type": "git",
    "url": "https://github.com/drobilica/switchblade.git"
  },
  "homepage": "https://github.com/drobilica/switchblade#readme",
  "license": "MIT"
}
